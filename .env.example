# Copy this file to .env. Choose a unique admin password of at least 16 characters.
ADMIN_PASSWORD=
PORT=3000
# Production: set NODE_ENV=production, use HTTPS, and set PUBLIC_ORIGIN to your URL.
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Set to 1 only behind exactly one trusted reverse proxy (e.g. your own nginx).
TRUST_PROXY=0
