{
  "name": "nitc-ep-yearbook",
  "version": "1.0.0",
  "private": true,
  "description": "Student yearbook with private submissions and admin moderation",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/backend.test.js tests/worker.test.js",
    "test:ui": "node tests/check.cjs && node tests/full-flow.cjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "npm run build:cloudflare && node scripts/test-cloudflare.mjs",
    "backup:cloudflare": "node scripts/backup-cloudflare.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "wrangler": "^4.158.0"
  }
}
